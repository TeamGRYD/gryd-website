---
import { PLACEHOLDERS } from '../data/placeholders';
import { SITE } from '../lib/site';
interface Field { name: string; label: string; type?: 'text' | 'email' | 'url' | 'textarea' | 'select'; required?: boolean; options?: string[]; placeholder?: string }
interface Props { formName: string; fields: Field[]; submitLabel: string }
const { formName, fields, submitLabel } = Astro.props;
const endpoint = PLACEHOLDERS['PH-23'].value;
const dev = import.meta.env.DEV;
---
<form class="intake grid gap-5" method="post" action={endpoint || undefined} name={formName} data-form={formName}>
  <input type="hidden" name="_form" value={formName} />
  <input type="hidden" name="_redirect" value={`${SITE.url}/thanks/`} />
  <div class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
  {fields.map((f) => (
    <div class="grid gap-2">
      <label for={`${formName}-${f.name}`} class="label label-fg">{f.label}{f.required && <span class="text-accent" aria-hidden="true"> *</span>}</label>
      {f.type === 'textarea' ? (
        <textarea id={`${formName}-${f.name}`} name={f.name} rows="5" required={f.required} placeholder={f.placeholder} class="field" />
      ) : f.type === 'select' ? (
        <select id={`${formName}-${f.name}`} name={f.name} required={f.required} class="field">
          <option value="">Choose one</option>
          {f.options?.map((o) => <option>{o}</option>)}
        </select>
      ) : (
        <input id={`${formName}-${f.name}`} name={f.name} type={f.type ?? 'text'} required={f.required} placeholder={f.placeholder} class="field" autocomplete={f.type === 'email' ? 'email' : f.name === 'name' ? 'name' : 'off'} />
      )}
    </div>
  ))}
  {endpoint ? (
    <button type="submit" class="btn btn-accent justify-self-start">{submitLabel}</button>
  ) : (
    <div>
      {dev && <p class="ph-note">PH-23: set the form endpoint in src/data/placeholders.ts to enable submissions.</p>}
      <button type="button" class="btn btn-accent justify-self-start opacity-60" disabled aria-disabled="true">{submitLabel}</button>
      <p class="mt-3 text-sm text-dim">The form opens soon. Until then, message us on <a href={SITE.social.x} class="text-accent underline underline-offset-4">X ({SITE.xHandle})</a>.</p>
    </div>
  )}
</form>
<style>
  .field { width: 100%; background: var(--sheet); border: 0; border-bottom: 1px solid var(--line-2); padding: .75rem .1rem; color: var(--text); font: inherit; }
  .field:focus { border-bottom-color: var(--accent); outline: none; background: var(--raise); }
  .field::placeholder { color: var(--faint); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .ph-note { border: 1.5px dashed var(--warn); color: var(--warn); padding: .5rem .7rem; font-family: var(--font-mono); font-size: .75rem; margin-bottom: .75rem; }
</style>
