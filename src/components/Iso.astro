---
/**
 * Isometric line drawings generated from boxes: no raster images.
 * Faces are filled (hidden-line) and drawn back-to-front; strokes "draw in" on scroll (.draw).
 */
interface Box { x: number; y: number; z?: number; w: number; d: number; h: number; accent?: boolean; ghost?: boolean }
interface Props { scene: 'city' | 'build' | 'curate' | 'educate' | 'contribute' | 'delegate' | 'agents'; class?: string; label?: string; now?: boolean }
const { scene, class: cls = '', label, now = false } = Astro.props;

const scenes: Record<Props['scene'], Box[]> = {
  city: (() => {
    const hs = [3, 1, 4, 2, 1, 2, 5, 1, 3, 2, 1, 3, 2, 6, 1, 2, 1, 2, 4, 1, 3, 1, 2, 1, 2];
    const out: Box[] = [];
    for (let gx = 0; gx < 5; gx++) for (let gy = 0; gy < 5; gy++) {
      const h = hs[gx * 5 + gy];
      out.push({ x: gx * 1.25, y: gy * 1.25, w: 1, d: 1, h: h * 0.55, accent: gx === 2 && gy === 3 });
    }
    return out;
  })(),
  build: [
    { x: 0, y: 0, w: 3, d: 2, h: 0.8 },
    { x: 0.4, y: 0.3, z: 0.8, w: 2.2, d: 1.4, h: 0.8 },
    { x: 0.8, y: 0.55, z: 1.6, w: 1.4, d: 0.9, h: 0.8 },
    { x: 1.15, y: 0.75, z: 2.4, w: 0.7, d: 0.5, h: 0.7, accent: true },
  ],
  curate: [
    { x: 0, y: 0, w: 2.6, d: 3.2, h: 0.12 },
    { x: 0.25, y: 0.25, z: 0.12, w: 2.6, d: 3.2, h: 0.12 },
    { x: 0.5, y: 0.5, z: 0.24, w: 2.6, d: 3.2, h: 0.12, accent: true },
    { x: 2.2, y: 2.9, z: 0.36, w: 0.35, d: 0.35, h: 1.6 },
  ],
  educate: [
    { x: 0, y: 0, w: 4, d: 1, h: 1.2 },
    { x: 0, y: 1, w: 4, d: 1, h: 0.8 },
    { x: 0, y: 2, w: 4, d: 1, h: 0.4 },
    { x: 1.6, y: 3.4, w: 0.8, d: 0.8, h: 0.8, accent: true },
  ],
  contribute: [
    { x: 0, y: 0, w: 1, d: 1, h: 1 }, { x: 1.1, y: 0, w: 1, d: 1, h: 1 }, { x: 0, y: 1.1, w: 1, d: 1, h: 1 }, { x: 1.1, y: 1.1, w: 1, d: 1, h: 1 },
    { x: 0, y: 0, z: 1.05, w: 1, d: 1, h: 1 }, { x: 1.1, y: 0, z: 1.05, w: 1, d: 1, h: 1 }, { x: 0, y: 1.1, z: 1.05, w: 1, d: 1, h: 1 },
    { x: 1.1, y: 1.1, z: 1.45, w: 1, d: 1, h: 1, accent: true },
  ],
  delegate: [
    { x: 0, y: 0, w: 1.4, d: 1.4, h: 1.6 },
    { x: 3, y: 0, w: 1.4, d: 1.4, h: 1.0 },
    { x: 1.4, y: 0.45, z: 0.9, w: 1.6, d: 0.5, h: 0.12, accent: true },
  ],
  agents: [
    { x: 0, y: 0, w: 3, d: 2, h: 0.25 },
    { x: 0.3, y: 0.3, z: 0.25, w: 2.4, d: 1.4, h: 1.4 },
    { x: 0.6, y: 0.6, z: 1.65, w: 0.3, d: 0.3, h: 0.3, accent: true },
  ],
};
const boxes = [...scenes[scene]].sort((a, b) => (a.x + a.y) - (b.x + b.y) || (a.z ?? 0) - (b.z ?? 0));
const C = Math.cos(Math.PI / 6), S = Math.sin(Math.PI / 6);
const P = (x: number, y: number, z: number) => [(x - y) * C, (x + y) * S - z];
const polys = boxes.map((b) => {
  const z = b.z ?? 0;
  const pts = (arr: number[][]) => arr.map(([x, y, zz]) => P(x, y, zz).map((n) => n.toFixed(3)).join(',')).join(' ');
  return {
    accent: b.accent,
    top: pts([[b.x, b.y, z + b.h], [b.x + b.w, b.y, z + b.h], [b.x + b.w, b.y + b.d, z + b.h], [b.x, b.y + b.d, z + b.h]]),
    right: pts([[b.x + b.w, b.y, z], [b.x + b.w, b.y + b.d, z], [b.x + b.w, b.y + b.d, z + b.h], [b.x + b.w, b.y, z + b.h]]),
    left: pts([[b.x, b.y + b.d, z], [b.x + b.w, b.y + b.d, z], [b.x + b.w, b.y + b.d, z + b.h], [b.x, b.y + b.d, z + b.h]]),
  };
});
const all = boxes.flatMap((b) => {
  const z = b.z ?? 0;
  return [[b.x, b.y, z], [b.x + b.w, b.y + b.d, z + b.h], [b.x + b.w, b.y, z], [b.x, b.y + b.d, z + b.h], [b.x, b.y, z + b.h], [b.x + b.w, b.y + b.d, z]].map(([x, y, zz]) => P(x, y, zz));
});
const pad = 0.25;
const minX = Math.min(...all.map((p) => p[0])) - pad, maxX = Math.max(...all.map((p) => p[0])) + pad;
const minY = Math.min(...all.map((p) => p[1])) - pad, maxY = Math.max(...all.map((p) => p[1])) + pad;
const sw = ((maxX - minX) / 260).toFixed(4); // ≈1px at typical render width
const vb = `${minX.toFixed(2)} ${minY.toFixed(2)} ${(maxX - minX).toFixed(2)} ${(maxY - minY).toFixed(2)}`;
---
<svg class:list={['iso draw', { now }, cls]} viewBox={vb} style={`--sw:${sw}`} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {polys.map((p) => (
    <g class:list={{ acc: p.accent }}>
      <polygon class="f-left" points={p.left} pathLength="1" data-d />
      <polygon class="f-right" points={p.right} pathLength="1" data-d />
      <polygon class="f-top" points={p.top} pathLength="1" data-d />
    </g>
  ))}
</svg>

<style>
  .iso { display: block; width: 100%; height: auto; }
  .iso polygon { stroke: var(--text); stroke-width: var(--sw); stroke-linejoin: round; }
  .f-top { fill: var(--raise); }
  .f-right { fill: var(--sheet); }
  .f-left { fill: var(--ink); }
  .acc .f-top { fill: var(--accent); }
  .acc .f-right { fill: color-mix(in oklab, var(--accent) 55%, var(--ink)); }
  .acc .f-left { fill: color-mix(in oklab, var(--accent) 30%, var(--ink)); }
  .acc polygon { stroke: var(--accent); }
</style>
