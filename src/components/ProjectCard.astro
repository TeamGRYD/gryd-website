---
/** Project as a spec sheet cell. */
import type { CollectionEntry } from 'astro:content';
import { statusLabel, roleLabel } from '../lib/labels';
import { phValue } from '../data/placeholders';
interface Props { project: CollectionEntry<'projects'>; n?: number; headingLevel?: 'h2' | 'h3' }
const { project, n, headingLevel = 'h3' } = Astro.props;
const d = project.data;
const H = headingLevel;
let [status, tone] = statusLabel[d.status];
if (d.statusPlaceholder && phValue(d.statusPlaceholder)) [status, tone] = [phValue(d.statusPlaceholder), 'success'];
const hideStatus = d.statusPlaceholder && !phValue(d.statusPlaceholder) && d.status === 'unknown' && d.category === 'product';
const toneCls = { success: 'tag-accent', warn: 'tag-amber', danger: 'tag-red', accent: 'tag-accent', plain: '' }[tone];
---
<article class="spec cell-link flex h-full flex-col" data-ecosystems={d.ecosystems.join(' ').toLowerCase()}>
  <div class="flex items-center justify-between border-b border-line px-5 py-2.5">
    <span class="label num">{n !== undefined ? `B-${String(n).padStart(2, '0')}` : 'B'} · {d.years}</span>
    <span class="arrow text-dim" aria-hidden="true">↗</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap gap-1.5">
      <span class="tag tag-solid">{d.roleLabel ?? roleLabel[d.role]}</span>
      {!hideStatus && <span class:list={['tag', toneCls]}>{status}</span>}
    </div>
    <H class="title mt-5 text-[1.45rem]"><a href={`/builders/${project.id}/`} class="stretch">{d.name}</a></H>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-dim">{d.summary}</p>
    <dl class="mt-auto grid grid-cols-2 gap-x-4 gap-y-1 pt-6">
      <dt class="label">Ecosystem</dt><dd class="label label-fg truncate text-right">{d.ecosystems.join(' / ')}</dd>
      {d.funding[0] && <><dt class="label">Funded by</dt><dd class="label label-fg truncate text-right">{d.funding[0].program.split(',')[0]}</dd></>}
    </dl>
  </div>
</article>
