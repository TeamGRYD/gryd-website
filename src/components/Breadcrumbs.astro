---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="board">
  <ol class="pad-x flex flex-wrap items-center gap-2 border-b border-line py-2.5 font-mono text-[0.6875rem] uppercase tracking-[0.06em] text-faint">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i < items.length - 1 ? <a href={it.href} class="hover:text-fg">{it.name}</a> : <span aria-current="page" class="text-dim">{it.name}</span>}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
