---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import StatusBar from '../components/StatusBar.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, absUrl } from '../lib/site';
import { graph, organization, website, breadcrumbs as bcSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  crumbs?: { name: string; href: string }[];
  schema?: object[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  agentMode?: boolean;
  preloadMono?: boolean;
}
const { title, description, type = 'website', crumbs = [], schema = [], noindex = false, published, modified, agentMode = false, preloadMono = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = absUrl(path);
const ogPath = `/og${path === '/' ? '/index' : path.replace(/\/$/, '')}.png`;
const ogImage = absUrl(ogPath);
const mdPath = path === '/' ? '/index.md' : `${path.replace(/\/$/, '')}.md`;
const allCrumbs = crumbs.length ? [{ name: 'Home', href: '/' }, ...crumbs] : [];
const ld = graph(organization(), website(), ...(allCrumbs.length ? [bcSchema(allCrumbs)] : []), ...schema);
---
<!doctype html>
<html lang={SITE.lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <script is:inline>try{var t=localStorage.getItem('theme');if(t==='light')document.documentElement.dataset.theme='light'}catch(e){}</script>
    {import.meta.env.DEV && <script is:inline>if(/[?&]ph\b/.test(location.search))document.documentElement.dataset.ph=''</script>}
    <link rel="preload" href="/fonts/archivo-sub.woff2" as="font" type="font/woff2" crossorigin />
    {preloadMono && <link rel="preload" href="/fonts/mono-sub.woff2" as="font" type="font/woff2" crossorigin />}
    <meta name="theme-color" content="#0d0b10" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/markdown" href={mdPath} title="Markdown version for AI agents" />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title="GRYD Blog" />
    <link rel="alternate" type="application/feed+json" href="/feed.json" title="GRYD Blog (JSON)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script type="speculationrules" is:inline set:html={JSON.stringify({ prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { selector_matches: '[href$=".md"], [href$=".txt"], [href$=".xml"], [href$=".json"], [rel~="nofollow"]' } }] }, eagerness: 'moderate' }] })} />
  </head>
  <body class:list={[{ 'agent-mode': agentMode }]}>
    <a href="#main" class="skip">Skip to content</a>
    <TopBar />
    {allCrumbs.length > 0 && <Breadcrumbs items={allCrumbs} />}
    <main id="main" data-pagefind-body>
      <slot />
    </main>
    <TitleBlock />
    <StatusBar agentMode={agentMode} />
  </body>
</html>
